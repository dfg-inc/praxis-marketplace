{
  "name": "praxis-marketplace",
  "private": true,
  "version": "0.1.0-alpha.48",
  "description": "Praxis Marketplace site",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "fetch:docs": "node tools/scripts/fetch-docs-ci.mjs",
    "sync-docs": "node tools/scripts/sync-user-docs.mjs",
    "build": "npm run build -w @praxis/marketplace-site",
    "accept:marketplace": "node tools/scripts/marketplace-site-acceptance.mjs",
    "verify": "npm run fetch:docs && npm run sync-docs && npm run build && npm run accept:marketplace",
    "check:rc": "node tools/scripts/verify-release-candidate.mjs",
    "test:rc": "node --test tools/scripts/verify-release-candidate.test.mjs",
    "check:marketplace": "node tools/scripts/check-marketplace.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@praxis/catalog": "file:vendor/praxis-catalog-0.1.0-alpha.44.tgz"
  },
  "devDependencies": {
    "esbuild": "0.21.5"
  }
}
