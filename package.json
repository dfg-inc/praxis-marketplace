{
  "name": "praxis-marketplace",
  "private": true,
  "version": "0.1.0-alpha.48",
  "description": "Praxis Claude plugin marketplace: .claude-plugin/marketplace.json and the installable plugins/",
  "scripts": {
    "check:marketplace": "node tools/scripts/check-marketplace.mjs",
    "check:outputs": "node tools/scripts/check-plugin-outputs.mjs",
    "check:rc": "node tools/scripts/verify-release-candidate.mjs",
    "test:rc": "node --test tools/scripts/verify-release-candidate.test.mjs",
    "stage": "node tools/scripts/stage-portable-plugins.mjs",
    "verify": "npm run check:marketplace && npm run check:outputs && npm run test:rc"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "0.21.5"
  }
}
